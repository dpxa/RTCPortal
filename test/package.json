{
  "name": "rtcportal-selenium-tests",
  "version": "1.0.0",
  "description": "Selenium tests for RTCPortal",
  "private": true,
  "main": "selenium/connection-test.js",
  "config": {
    "local_url": "http://localhost:3000",
    "prod_url": "https://dpxa.github.io/RTCPortal/"
  },
  "scripts": {
    "test:regression": "node run-regression-suite.js",
    "test:coverage": "node run-regression-suite.js --coverage",
    "test:connection:local": "cross-env TEST_URL=$npm_package_config_local_url node selenium/connection-test.js",
    "test:connection:prod": "cross-env TEST_URL=$npm_package_config_prod_url node selenium/connection-test.js",
    "test:ui:local": "cross-env TEST_URL=$npm_package_config_local_url node selenium/ui-test.js",
    "test:ui:prod": "cross-env TEST_URL=$npm_package_config_prod_url node selenium/ui-test.js",
    "test:selenium:local": "npm run test:connection:local && npm run test:ui:local",
    "test:all": "npm run test:regression && npm run test:selenium:local",
    "lint": "npm --prefix .. run lint -- test/**/*.js",
    "lint:fix": "npm --prefix .. run lint:fix -- test/**/*.js"
  },
  "dependencies": {
    "selenium-webdriver": "^4.27.0",
    "socket.io-client": "^4.8.1"
  },
  "keywords": [
    "selenium",
    "webrtc",
    "test"
  ],
  "author": "dpxa",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1"
  }
}
